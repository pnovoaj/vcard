{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pnovoaj-vcard",
  "main": "src/worker.js",
  "compatibility_date": "2026-08-01",
  "workers_dev": true,
  "routes": [
    {
      "pattern": "contacto.clubalbatros.cl",
      "custom_domain": true
    }
  ],
  "secrets": {
    "required": [
      "NFC_TOKEN_HASHES",
      "CONTACT_WORK_URL",
      "CONTACT_PERSONAL_URL"
    ]
  },
  "ratelimits": [
    {
      "name": "CONTACT_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 30,
        "period": 60
      }
    }
  ]
}
